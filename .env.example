# Copy this file to .env and fill in your own values. Never commit .env.

# Required: your Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_key_here

# Optional overrides (defaults shown)
# VISION_PROVIDER=gemini
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_TIMEOUT_SECONDS=30
# CONFIDENCE_THRESHOLD=0.85
# MIN_DIGIT_COUNT=4
# MAX_DIGIT_COUNT=10
# MAX_IMAGE_DIMENSION_PX=2000
# MAX_UPLOAD_SIZE_MB=15

# --- backend (FastAPI billing system) ---

# Required: at least 32 bytes. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate_your_own_secret_key_here

# Optional overrides (defaults shown)
# ENVIRONMENT=development
# DATABASE_URL=sqlite:///backend/gastool.db
# ACCESS_TOKEN_TTL_MINUTES=30
# REFRESH_TOKEN_TTL_DAYS_RESIDENT=14
# REFRESH_TOKEN_TTL_DAYS_ADMIN=7
# OTP_EXPIRY_MINUTES=5
# OTP_MAX_ATTEMPTS=5
# CORS_ORIGINS=http://localhost:8501
